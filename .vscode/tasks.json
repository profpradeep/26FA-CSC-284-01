{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile active C++23 file",
      "type": "process",
      "command": "g++-15",
      "args": [
        "-std=c++23",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/.vscode/build/${fileBasenameNoExtension}.exe"
      ],
      "windows": {
        "command": "g++",
        "args": [
          "-std=c++23",
          "-g",
          "${file}",
          "-o",
          "${workspaceFolder}/.vscode/build/${fileBasenameNoExtension}.exe",
          "-lstdc++exp"
        ]
      },
      "linux": {
        "command": "g++-15"
      },
      "osx": {
        "command": "g++-15"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Compile the active source file as a standalone C++23 program."
    },
    {
      "label": "Compile active C++23 folder",
      "type": "process",
      "command": "sh",
      "args": [
        "-c",
        "set -eu\nset -- \"$CPP_SOURCE_DIR\"/*.cpp\nif [ ! -f \"$1\" ]; then\n  echo \"No .cpp files found in the active folder.\" >&2\n  exit 1\nfi\nmkdir -p \"$CPP_BUILD_DIR\"\n\"$CPP_COMPILER\" -std=c++23 -g \"$@\" -o \"$CPP_BUILD_DIR/program.exe\""
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "CPP_SOURCE_DIR": "${fileDirname}",
          "CPP_BUILD_DIR": "${workspaceFolder}/.vscode/build",
          "CPP_COMPILER": "g++-15"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-Command",
          "$ErrorActionPreference = 'Stop'; $sources = @(Get-ChildItem -LiteralPath $env:CPP_SOURCE_DIR -File -Filter '*.cpp' | Sort-Object Name); if ($sources.Count -eq 0) { throw 'No .cpp files found in the active folder.' }; New-Item -ItemType Directory -Force -Path $env:CPP_BUILD_DIR | Out-Null; $output = Join-Path $env:CPP_BUILD_DIR 'program.exe'; $sourcePaths = @($sources | ForEach-Object { $_.FullName }); & $env:CPP_COMPILER '-std=c++23' '-g' @sourcePaths '-o' $output '-lstdc++exp'; exit $LASTEXITCODE"
        ],
        "options": {
          "cwd": "${fileDirname}",
          "env": {
            "CPP_SOURCE_DIR": "${fileDirname}",
            "CPP_BUILD_DIR": "${workspaceFolder}/.vscode/build",
            "CPP_COMPILER": "g++"
          }
        }
      },
      "linux": {
        "options": {
          "cwd": "${fileDirname}",
          "env": {
            "CPP_SOURCE_DIR": "${fileDirname}",
            "CPP_BUILD_DIR": "${workspaceFolder}/.vscode/build",
            "CPP_COMPILER": "g++-15"
          }
        }
      },
      "osx": {
        "options": {
          "cwd": "${fileDirname}",
          "env": {
            "CPP_SOURCE_DIR": "${fileDirname}",
            "CPP_BUILD_DIR": "${workspaceFolder}/.vscode/build",
            "CPP_COMPILER": "g++-15"
          }
        }
      },
      "problemMatcher": "$gcc",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Compile every .cpp file in the active source file's folder as one C++23 program."
    }
  ]
}
