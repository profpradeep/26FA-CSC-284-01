{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run C++23 folder (single .cpp file)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/build/${fileBasenameNoExtension}",
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "preLaunchTask": "Compile C++23 folder",
      "windows": {
        "program": "${workspaceFolder}/.vscode/build/${fileBasenameNoExtension}.exe",
        "miDebuggerPath": "gdb.exe"
      },
      "linux": {
        "miDebuggerPath": "gdb"
      },
      "osx": {
        "MIMode": "lldb"
      }
    },
    {
      "name": "Run C++23 folder (multiple .cpp files)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/build/program",
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "preLaunchTask": "Compile C++23 folder",
      "windows": {
        "program": "${workspaceFolder}/.vscode/build/program.exe",
        "miDebuggerPath": "gdb.exe"
      },
      "linux": {
        "miDebuggerPath": "gdb"
      },
      "osx": {
        "MIMode": "lldb"
      }
    }
  ]
}
